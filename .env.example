# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).

# --- Infrastructure ----------------------------------------------------------
POSTGRES_USER=mirage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mirage
DATABASE_URL=postgresql+asyncpg://mirage:change-me@localhost:5432/mirage
REDIS_URL=redis://localhost:6379/0

# --- Honeypot ----------------------------------------------------------------
HONEYPOT_SSH_PORT=2222
HONEYPOT_PERSONA=ubuntu-webserver

# --- LLM providers -----------------------------------------------------------
# Three roles, each pluggable: groq | gemini | ollama
# Model names come ONLY from env. The defaults below are placeholders: Part 3
# must confirm current model names in each provider's docs before relying on them.

# Live shell replies (needs to be fast)
SHELL_LLM_PROVIDER=groq
SHELL_LLM_MODEL=llama-3.1-8b-instant

# Post-session attacker analysis (needs long context + JSON output)
ANALYSIS_LLM_PROVIDER=gemini
ANALYSIS_LLM_MODEL=gemini-2.5-flash

# Used when the primary provider is rate limited, times out or errors
FALLBACK_LLM_PROVIDER=ollama
FALLBACK_LLM_MODEL=qwen2.5:7b

# API keys (free tiers): https://console.groq.com/keys , https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Budgets (per provider) --------------------------------------------------
# Mirage switches to the fallback BEFORE these are reached. Set them at or below
# your account's real free-tier limits. 0 = unlimited.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_DAILY_REQUEST_BUDGET=10000
GROQ_DAILY_TOKEN_BUDGET=400000

GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_DAILY_REQUEST_BUDGET=200
GEMINI_DAILY_TOKEN_BUDGET=800000

OLLAMA_REQUESTS_PER_MINUTE=0
OLLAMA_DAILY_REQUEST_BUDGET=0
OLLAMA_DAILY_TOKEN_BUDGET=0

# Per attacker session cap on AI-handled commands and tokens
SESSION_LLM_REQUEST_BUDGET=60
SESSION_LLM_TOKEN_BUDGET=30000

# --- Enrichment (Part 4, optional) -------------------------------------------
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
ABUSEIPDB_API_KEY=

# --- Dashboard API (Part 6) --------------------------------------------------
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD_HASH=
API_JWT_SECRET=
API_CORS_ORIGINS=http://localhost:5173
